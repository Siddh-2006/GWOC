# MindSettler Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# BACKEND ENVIRONMENT VARIABLES
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mindsettler

# JWT Configuration (Generate secure random strings)
JWT_ACCESS_SECRET=your-super-secure-access-secret-here-256-bits-minimum
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-here-256-bits-minimum

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
SKIP_EMAIL=false

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# AI Services
GEMINI_KEYS=your-gemini-api-key-here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================================

# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=MindSettler
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_BOOKING=true
VITE_ENABLE_PSYCHO_EDUCATION=true

# ===========================================
# PRODUCTION NOTES
# ===========================================

# For production deployment:
# 1. Generate new secure JWT secrets (use crypto.randomBytes(64).toString('hex'))
# 2. Use production MongoDB Atlas connection string
# 3. Set up Gmail App Password for email service
# 4. Configure Cloudinary for production
# 5. Get production Gemini API key
# 6. Update FRONTEND_URL and CORS_ORIGIN to production domains
# 7. Set NODE_ENV=production
# 8. Set VITE_APP_ENV=production