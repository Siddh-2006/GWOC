# Keep-Alive Service Configuration

# Backend URL to keep alive
BACKEND_URL=https://gwoc-lovat.vercel.app

# MongoDB URI for direct database pings
MONGODB_URI=mongodb+srv://mindsettler:zovotfSQfFEvnml8@mindsettler.791pbco.mongodb.net/?appName=MindSettler

# Ping interval (cron format)
# */5 * * * * = Every 5 minutes
# */3 * * * * = Every 3 minutes  
# */10 * * * * = Every 10 minutes
PING_INTERVAL=*/5 * * * *

# Port for the keep-alive service (for local development)
PORT=3000

# Optional: Slack webhook for notifications (future feature)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: Email notifications (future feature)
# EMAIL_FROM=keepalive@yourdomain.com
# EMAIL_TO=admin@yourdomain.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password