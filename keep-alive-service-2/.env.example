# Secondary Keep-Alive Service Configuration

# Backend URL to keep alive
BACKEND_URL=https://gwoc-lovat.vercel.app

# First keep-alive service URL to keep alive
KEEPALIVE_SERVICE_1_URL=https://gwoc-duplicate.onrender.com

# Ping interval (cron format) - offset from first service
# */7 * * * * = Every 7 minutes (offset from Service #1's 5 minutes)
# */6 * * * * = Every 6 minutes
# */8 * * * * = Every 8 minutes
PING_INTERVAL=*/7 * * * *

# Port for the service (for local development)
PORT=3000