{
  "version": 2,
  "name": "mindsettler-keep-alive-2",
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "crons": [
    {
      "path": "/ping",
      "schedule": "0 */6 * * *"
    }
  ],
  "env": {
    "BACKEND_URL": "https://gwoc-lovat.vercel.app",
    "KEEPALIVE_SERVICE_1_URL": "https://gwoc-duplicate.onrender.com",
    "PING_INTERVAL": "0 */6 * * *"
  }
}