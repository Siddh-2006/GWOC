# Environment
NODE_ENV=production

# Server Configuration
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/mindsettler

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secure-access-secret-key-here
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-here

# Email Configuration (Required for production)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Contact Form Email Settings (Gmail Only)
# EMAIL_USER: The Gmail address that will send emails (e.g., contact@mindsettler.com)
EMAIL_USER=contact@mindsettler.com

# EMAIL_PASS: Gmail App Password (NOT your regular password)
# Generate this at: Google Account → Security → 2-Step Verification → App passwords
EMAIL_PASS=your-gmail-app-password-16-chars

# ADMIN_EMAIL: Where contact form notifications will be sent
ADMIN_EMAIL=admin@mindsettler.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Development Settings (Remove in production)
# SKIP_EMAIL=true