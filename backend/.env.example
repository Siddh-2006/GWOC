# Environment
NODE_ENV=production

# Server Configuration
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/mindsettler

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secure-access-secret-key-here
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-here

# Email Configuration (Required for production)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-16-chars

# EMAIL_PASSWORD: Gmail App Password (NOT your regular password)
# Generate this at: Google Account → Security → 2-Step Verification → App passwords
# Remove spaces from the app password (e.g., "abcd efgh ijkl mnop" becomes "abcdefghijklmnop")
EMAIL_PASSWORD=your-gmail-app-password-16-chars

# ADMIN_EMAIL: Where contact form notifications will be sent
ADMIN_EMAIL=admin@mindsettler.com

# Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Cloudinary Configuration (Required for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# AI Services
# Single key format: GEMINI_API_KEY=your_key_here
# Multiple keys format (comma-separated): GEMINI_KEYS=key1,key2,key3
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_KEYS=your-gemini-api-key-here

# Development Settings (Remove in production)
# SKIP_EMAIL=true